# Copie para .env local (não commitar)
PORT=3001
YOLO_MODEL=fp32

# Taxa alvo de inferência no feed (1–60 FPS). O FPS real depende do hardware.
# É apenas um teto: o pipeline reduz sozinho a taxa se o modelo não acompanhar.
INFERENCE_FPS=12

# 0 = desliga o YOLO no servidor e roda a inferência no navegador (worker),
# que é o modo usado em produção na Vercel. Útil para testar esse caminho local.
# USE_LOCAL_YOLO=0

# 1 = envia COOP/COEP para habilitar SharedArrayBuffer, o que permite ao
# onnxruntime-web rodar WASM multi-thread (medido: ~4x mais rápido).
# Chromium/Firefox mantêm os scripts de CDN funcionando via COEP credentialless;
# o Safari simplesmente continua single-thread.
# CROSS_ORIGIN_ISOLATION=1

# Opcional — usar Roboflow na Vercel se o cold start do ONNX estourar 10s
# DETECTION_BACKEND=roboflow
# ROBOFLOW_API_KEY=
# ROBOFLOW_PROJECT_WEAPON=
# ROBOFLOW_PROJECT_MASK=
